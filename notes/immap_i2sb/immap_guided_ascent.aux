\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Held-out examples, 50 steps, from the same trained network. \emph  {Columns 1--3:} the target, the start $\bm  {x}_1$, and the one-shot regression $\mathbb  {E}[\bm  {x}_0\mid \bm  {x}_1]$ (the first step of either sampler), which is blurry. \emph  {Columns 4--6:} two I$^2$SB samples (start $\bm  {x}_1$, $\sigma =\infty $) and the per-pixel standard deviation over 8 samples. \emph  {Columns 7--9:} the same for the ascent started at pure noise ($\sigma =80$). The two starts produce samples of the same character, and their uncertainty concentrates on the same edges and textures that the low-resolution start cannot resolve.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:samples}{{3}{10}{Held-out examples, 50 steps, from the same trained network. \emph {Columns 1--3:} the target, the start $\x _1$, and the one-shot regression $\E [\x _0\mid \x _1]$ (the first step of either sampler), which is blurry. \emph {Columns 4--6:} two I$^2$SB samples (start $\x _1$, $\sigma =\infty $) and the per-pixel standard deviation over 8 samples. \emph {Columns 7--9:} the same for the ascent started at pure noise ($\sigma =80$). The two starts produce samples of the same character, and their uncertainty concentrates on the same edges and textures that the low-resolution start cannot resolve}{figure.3}{}}
