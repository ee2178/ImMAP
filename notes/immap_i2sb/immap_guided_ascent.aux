\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Step-count sweep on the CIFAR task. \emph  {Top:} the two networks on the two ladders: I$^2$SB's $t$-grid from $\bm  {x}_1$, and a $\rho =7$ $\sigma $-ladder from noise at $\sigma =80$. \emph  {Bottom:} the bridge network with a different start and ladder. It regresses at $\sigma =\infty $, re-noises to $\sigma _0$, then follows geometric target levels, either open loop or self-paced (Section~\ref {sec:sweep}). The dotted line marks the one-shot regression's detail. Note the narrow range of the bottom-left panel.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:sweep}{{4}{12}{Step-count sweep on the CIFAR task. \emph {Top:} the two networks on the two ladders: I$^2$SB's $t$-grid from $\x _1$, and a $\rho =7$ $\sigma $-ladder from noise at $\sigma =80$. \emph {Bottom:} the bridge network with a different start and ladder. It regresses at $\sigma =\infty $, re-noises to $\sigma _0$, then follows geometric target levels, either open loop or self-paced (Section~\ref {sec:sweep}). The dotted line marks the one-shot regression's detail. Note the narrow range of the bottom-left panel}{figure.4}{}}
