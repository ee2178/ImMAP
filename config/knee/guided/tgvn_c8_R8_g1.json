    "mri": {
        "R": 8,
        "acs_lines": null,
        "mask_dist": "uniform",
        "mask_offset": 0,
        "kspace_type": "measurement_awgn",
        "whiten_kspace": false,
        "center_frac": 0.04,
        "adjust_accel": true,
        "online_smaps": "espirit",
        "online_smaps_kws": {
            "thresh_eig": 0.0,
            "kernel_size": 4,
            "maxit": 10
        },
        "guide_R": 1,
        "guide_acs_lines": 0,
        "guide_mask_dist": "uniform"
    },
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 0.0005
        }
    },
    "scheduler": {
        "type": "CosineAnnealingLR",
        "params": {
            "eta_min": 1.0e-6,
            "T_max": 300000
        }
    },
    "wandb": {
        "project": "guided_recon",
        "id": null
    }
