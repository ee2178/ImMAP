            "num_workers": 8
        },
        "val": {
            "name": "fastmri_paired",
            "split_csv": "config/knee/guided/splits/val.csv",
            "kspace_roots": [
                "../datasets/fastmri/knee/multicoil_train",
                "../datasets/fastmri/knee/multicoil_val"
            ],
            "batch_size": 1,
            "start_slice": 12,
            "end_slice": 13,
            "scale_fac": 5000.0,
            "organ_mask_source": "none",
            "target": "sense",
            "smap_root": "../datasets/fastmri_preprocessed/knee_coil_combined/pdfs_espirit_acs32",
            "pad_multiple": 1,
            "num_workers": 8
        }
