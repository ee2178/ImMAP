{
    "task": "recon",
    "experiment": {
        "name": "guided_knee_PDFS_from_PD_lggs_R8"
    },
    "model": {
        "type": "LGGS",
        "params": {
            "K": 30,
            "M": 169,
            "C": 1,
            "P": 7,
            "s": 2,
            "Mh": 64,
            "window": 1,
            "guide_window": 15,
            "joint_softmax": true,
            "sim_fun": "pidistance",
            "lam0": 0.001,
            "tau0": 0.5,
            "theta0": 0.0,
            "dK": 5,
            "nheads": 1,
            "init_strategy": "semi_orthogonal",
            "is_complex": true,
            "preproc": "kspace",
            "attn_backend": "flex"
        }
    },
    "paths": {
        "save_dir": "trained_nets/guided_recon/knee/lggs_R8",
        "ckpt": null
    },
    "data": {
        "train": {
            "name": "fastmri_paired",
            "split_csv": "config/knee/guided/splits/train.csv",
            "kspace_roots": [
                "../datasets/fastmri/knee/multicoil_train",
                "../datasets/fastmri/knee/multicoil_val"
            ],
            "batch_size": 1,
            "start_slice": 12,
            "end_slice": 25,
            "scale_fac": 5000.0,
            "organ_mask_source": "none",
            "pad_multiple": 2,
            "num_workers": 8
        },
        "val": {
            "name": "fastmri_paired",
            "split_csv": "config/knee/guided/splits/val.csv",
            "kspace_roots": [
                "../datasets/fastmri/knee/multicoil_train",
                "../datasets/fastmri/knee/multicoil_val"
            ],
            "batch_size": 1,
            "start_slice": 12,
            "end_slice": 13,
            "scale_fac": 5000.0,
            "organ_mask_source": "none",
            "pad_multiple": 2,
            "num_workers": 8
        }
    },
    "training": {
        "num_epochs": 6000,
        "steps_per_epoch": 50,
        "val_every_epochs": 100,
        "noise_std": [
            0.01,
            0.02
        ],
        "noise_dist": "uniform",
        "val_noise_std": 0.015,
        "val_seed": 1234,
        "loss_type": "magnitude-nl1-nl2",
        "clip_grad": 0.05,
        "use_organ_mask": false,
        "backtrack_thresh": null,
        "backtrack_factor": 0.9
    },
    "mri": {
        "R": 8,
        "acs_lines": null,
        "mask_dist": "uniform",
        "mask_offset": 0,
        "kspace_type": "measurement_awgn",
        "whiten_kspace": false,
        "center_frac": 0.04,
        "adjust_accel": true,
        "online_smaps": "espirit",
        "online_smaps_kws": {
            "thresh_eig": 0.0,
            "kernel_size": 4,
            "maxit": 10
        }
    },
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 0.0002
        }
    },
    "scheduler": {
        "type": "CosineAnnealingLR",
        "params": {
            "eta_min": 1e-06,
            "T_max": 300000
        }
    },
    "wandb": {
        "project": "guided_recon",
        "id": null
    }
}
