{
    "task": "recon",
    "experiment": {
        "name": "AltSplitCDLNet_knee"
    },
    "model": {
        "type": "AltSplitCDLNet",
        "_comment": "Unrolled linearized ADMM: 5 layers, each an (E^H E + rho I) CG solve, a multigrid CDL denoiser as the prox, and a dual ascent step. Set smap_update to true to also refine the coil maps each layer. implicit_cg trades one extra CG solve in the backward for O(1) memory in the CG depth.",
        "params": {
            "admm_iters": 5,
            "reuse_latent": true,
            "smap_update": false,
            "rho0": 1.0,
            "cg_maxit": 10,
            "cg_tol": 1.0e-3,
            "implicit_cg": true,
            "preproc": "identity",
            "denoiser_type": "mgcdlnet",
            "denoiser_kws": {
                "K": [2, [6, 6, 4]],
                "M": 32,
                "Mh": 16,
                "C": 1,
                "P": 7,
                "s": 2,
                "W": 15,
                "dK": 5,
                "widen": 2,
                "is_complex": true,
                "resize_noise": true
            },
            "smap_kws": {
                "sigma_g": 1.5,
                "sigma_max": 3.0,
                "mu0": 1.0,
                "gamma0": 0.01
            }
        }
    },
    "paths": {
        "save_dir": "trained_nets/knee/AltSplitCDLNet",
        "ckpt": null
    },
    "training": {
        "num_epochs": 200,
        "steps_per_epoch": 200,
        "val_every_epochs": 5,
        "noise_std": [0.0, 0.02],
        "noise_dist": "uniform",
        "loss_type": "magnitude-mse",
        "clip_grad": 1.0
    },
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 2.0e-4
        }
    },
    "wandb": {
        "project": "recon_training",
        "id": null
    }
}
