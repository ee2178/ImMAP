{
    "task": "recon",
    "experiment": {
        "name": "AltSplitCDLNet_knee"
    },
    "model": {
        "type": "AltSplitCDLNet",
        "_comment": "Unrolled linearized ADMM: 5 layers, each an (E^H E + rho I) CG solve, a multigrid CDL denoiser as the prox, and a dual ascent step. smap_update is off: profiling put the coil-map CG solve at ~58-73% of the forward pass for a 2.5-3.5x increase in step time, and the dataset maps are already good. smap_kws is kept so flipping it back is one key. implicit_cg trades one extra CG solve in the backward for O(1) memory in the CG depth.",
        "params": {
            "admm_iters": 6,
            "reuse_latent": true,
            "smap_update": false,
            "rho0": 1.0,
            "cg_maxit": 10,
            "cg_tol": 0.0001,
            "implicit_cg": true,
            "preproc": "identity",
            "denoiser_type": "mgcdlnet",
            "denoiser_kws": {
                "K": [
                    1,
                    [
                        4,
                        4,
                        8
                    ]
                ],
                "M": 169,
                "C": 1,
                "P": 7,
                "s": 2,
                "degrees": 1,
                "tau0": 0.001,
                "widen": 1,
                "alpha0": 1.0,
                "alpha_conv": false,
                "dual": false,
                "is_complex": true,
                "resize_noise": true
            },
            "smap_kws": {
                "sigma_g": 1.5,
                "sigma_max": 3.0,
                "sigma_min": 0.3,
                "mu0": 1.0,
                "gamma0": 0.01
            }
        }
    },
    "paths": {
        "save_dir": "trained_nets/knee/AltSplitCDLNet",
        "ckpt": null
    },
    "data": {
        "train": {
            "name": "fastmri",
            "task": "recon",
            "anatomy": "knee",
            "batch_size": 1,
            "crop_size": null,
            "center_crop": null,
            "random_flips": false,
            "start_slice": 12,
            "end_slice": 25,
            "scale_fac": 5000.0,
            "kspace_root": "../datasets/fastmri/knee/multicoil_train",
            "smap_root": "../datasets/fastmri_preprocessed/knee_coil_combined/pd/train"
        },
        "val": {
            "name": "fastmri",
            "task": "recon",
            "anatomy": "knee",
            "batch_size": 1,
            "crop_size": null,
            "center_crop": null,
            "random_flips": false,
            "start_slice": 12,
            "end_slice": 13,
            "scale_fac": 5000.0,
            "kspace_root": "../datasets/fastmri/knee/multicoil_val",
            "smap_root": "../datasets/fastmri_preprocessed/knee_coil_combined/pd/val"
        }
    },
    "training": {
        "num_epochs": 6000,
        "steps_per_epoch": 50,
        "val_every_epochs": 100,
        "noise_std": [
            0.0,
            0.02
        ],
        "noise_dist": "uniform",
        "val_noise_std": 0.01,
        "val_seed": 1234,
        "loss_type": "magnitude-mse",
        "clip_grad": 1.0
    },
    "mri": {
        "R": 6,
        "acs_lines": 20,
        "mask_dist": "uniform",
        "mask_offset": 0,
        "kspace_type": "simulated",
        "whiten_kspace": false
    },
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 0.0002
        }
    },
    "scheduler": {
        "type": "CosineAnnealingLR",
        "params": {
            "eta_min": 1.0e-6,
            "T_max": 300000
        }
    },
    "wandb": {
        "project": "recon_training",
        "id": null
    }
}
