{
    "task": "recon",
    "experiment": {
        "name": "LPDSNet_knee_R8_synth"
    },
    "model": {
        "type": "LPDSNet",
        "params": {
            "K": 30,
            "M": 169,
            "P": 7,
            "s": 2,
            "C": 1,
            "l0": 0.001,
            "eta_0": 0.5,
            "theta_0": 0.0,
            "adaptive": true,
            "init": true,
            "preproc": "kspace"
        }
    },
    "paths": {
        "save_dir": "trained_nets/mg_recon/knee/lpdsnet_R8",
        "ckpt": null
    },
    "data": {
        "train": {
            "name": "fastmri",
            "task": "recon",
            "anatomy": "knee",
            "batch_size": 1,
            "crop_size": null,
            "center_crop": null,
            "random_flips": false,
            "start_slice": 12,
            "end_slice": 25,
            "scale_fac": 5000.0,
            "kspace_root": "../datasets/fastmri/knee/multicoil_train",
            "smap_root": "../datasets/fastmri_preprocessed/knee_coil_combined/pd/train"
        },
        "val": {
            "name": "fastmri",
            "task": "recon",
            "anatomy": "knee",
            "batch_size": 1,
            "crop_size": null,
            "center_crop": null,
            "random_flips": false,
            "start_slice": 12,
            "end_slice": 13,
            "scale_fac": 5000.0,
            "kspace_root": "../datasets/fastmri/knee/multicoil_val",
            "smap_root": "../datasets/fastmri_preprocessed/knee_coil_combined/pd/val"
        }
