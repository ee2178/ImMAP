    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 0.0005
        }
    },
    "scheduler": {
        "type": "CosineAnnealingLR",
        "params": {
            "eta_min": 1.0e-6,
            "T_max": 100000
        }
    },
    "wandb": {
        "project": "mg_recon",
        "id": null
