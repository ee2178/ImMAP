    "training": {
        "num_epochs": 500,
        "steps_per_epoch": 200,
        "val_every_epochs": 10,
        "noise_std": [
            0.0,
            0.01
        ],
        "noise_dist": "uniform",
        "val_noise_std": 0.005,
        "val_seed": 1234,
        "loss_type": "magnitude-nl1-nl2",
        "clip_grad": 1.0,
        "use_organ_mask": false,
        "backtrack_thresh": null,
