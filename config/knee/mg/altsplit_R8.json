{
    "task": "recon",
    "experiment": {
        "name": "AltSplitCDLNet_knee_R8_synth"
    },
    "model": {
        "type": "AltSplitCDLNet",
        "params": {
            "admm_iters": 6,
            "reuse_latent": true,
            "smap_update": true,
            "rho0": 1.0,
            "cg_maxit": 10,
            "cg_tol": 0.0001,
            "implicit_cg": true,
            "preproc": "identity",
            "denoiser_type": "mgcdlnet",
            "denoiser_kws": {
                "K": 6,
                "M": 169,
                "C": 1,
                "P": 7,
                "s": 2,
                "degrees": 1,
                "tau0": 0.001,
                "is_complex": true,
                "dual": false,
                "widen": 1,
                "alpha0": 1.0,
                "alpha_conv": false,
                "resize_noise": true
            },
            "smap_kws": {
                "sigma_g": 1.5,
                "sigma_max": 3.0,
                "sigma_min": 0.3,
                "mu0": 1.0,
                "gamma0": 0.01
            }
        }
    },
    "paths": {
        "save_dir": "trained_nets/mg_recon/knee/altsplit_R8",
        "ckpt": null
    },
    "data": {
        "train": {
            "name": "fastmri",
            "task": "recon",
            "anatomy": "knee",
            "batch_size": 1,
            "crop_size": null,
            "center_crop": null,
            "random_flips": false,
            "start_slice": 12,
            "end_slice": 25,
            "scale_fac": 5000.0,
            "kspace_root": "../datasets/fastmri/knee/multicoil_train",
            "smap_root": "../datasets/fastmri_preprocessed/knee_coil_combined/pd/train"
        },
        "val": {
            "name": "fastmri",
            "task": "recon",
            "anatomy": "knee",
            "batch_size": 1,
            "crop_size": null,
            "center_crop": null,
            "random_flips": false,
            "start_slice": 12,
            "end_slice": 13,
            "scale_fac": 5000.0,
            "kspace_root": "../datasets/fastmri/knee/multicoil_val",
            "smap_root": "../datasets/fastmri_preprocessed/knee_coil_combined/pd/val"
        }
    },
    "training": {
        "num_epochs": 500,
        "steps_per_epoch": 200,
        "val_every_epochs": 10,
        "noise_std": [
            0.0,
            0.01
        ],
        "noise_dist": "uniform",
        "val_noise_std": 0.005,
        "val_seed": 1234,
        "loss_type": "magnitude-nl1-nl2",
        "clip_grad": 1.0,
        "use_organ_mask": false,
        "backtrack_thresh": null,
        "backtrack_factor": 0.9
    },
    "mri": {
        "R": 8,
        "acs_lines": 20,
        "mask_dist": "uniform",
        "mask_offset": 0,
        "kspace_type": "simulated",
        "whiten_kspace": false
    },
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 0.0002
        }
    },
    "scheduler": {
        "type": "CosineAnnealingLR",
        "params": {
            "eta_min": 1.0e-6,
            "T_max": 100000
        }
    },
    "wandb": {
        "project": "mg_recon",
        "id": null
    }
}