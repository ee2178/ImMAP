{
    "task": "denoiser",
    "experiment": {
        "name": "MGGroupCDL_BSD432"
    },
    "model": {
        "type": "MGCDLNet",
        "_comment": "K = [K_outer, iters_per_level]: 3 outer V-cycles over 3 levels with 8/8/4 LISTA iterations. Non-coarsest entries must be even (pre/post smoothing halves). widen=2 doubles the subbands per level, U-Net style.",
        "params": {
            "K": [3, [8, 8, 4]],
            "M": 32,
            "Mh": 16,
            "C": 1,
            "P": 7,
            "s": 2,
            "W": 15,
            "dK": 5,
            "widen": 2,
            "nheads": 1,
            "sim_fun": "distance",
            "subgrad_mode": "rigorous",
            "alpha0": 0.1,
            "eta0": 0.1,
            "tau0": 0.001,
            "is_complex": false,
            "dual": false
        }
    },
    "paths": {
        "save_dir": "trained_nets/bsd432/MGGroupCDL_Denoiser",
        "ckpt": null
    },
    "data": {
        "train": {
            "name": "BSD432",
            "color": false,
            "batch_size": 8,
            "crop_size": 128,
            "center_crop": null,
            "random_flips": true,
            "root": "../datasets/CBSD432"
        },
        "val": {
            "name": "BSD432",
            "color": false,
            "batch_size": 1,
            "crop_size": null,
            "center_crop": null,
            "random_flips": false,
            "root": "../datasets/CBSD68"
        }
    },
    "training": {
        "num_epochs": 6000,
        "steps_per_epoch": 100,
        "val_every_epochs": 50,
        "noise_std": [0.098, 0.098],
        "noise_dist": "uniform",
        "loss_type": "magnitude-mse",
        "clip_grad": 5.0e-2,
        "backtrack_thresh": 2.0,
        "backtrack_factor": 0.9
    },
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 5.0e-4
        }
    },
    "scheduler": {
        "type": "CosineAnnealingLR",
        "params": {
            "eta_min": 2.0e-6,
            "T_max": 600000
        }
    },
    "wandb": {
        "project": "denoiser_training",
        "id": null
    }
}
