{
    "task": "denoiser",
    "experiment": {
        "name": "MGGroupLPDS_BSD432"
    },
    "model": {
        "type": "MGGroupLPDS",
        "_comment": "Same network as MGGroupCDL with dual=True pinned: the prox becomes z - GT(z) (group clipping, Moreau's identity) and the read-out becomes y~ - D z. Everything else is shared.",
        "params": {
            "K": [
                3,
                [
                    8,
                    8,
                    4
                ]
            ],
            "M": 64,
            "Mh": 64,
            "C": 1,
            "P": 7,
            "s": 2,
            "W": 35,
            "dK": 5,
            "widen": 2,
            "nheads": 1,
            "sim_fun": "distance",
            "subgrad_mode": "rigorous",
            "alpha0": 0.1,
            "eta0": 0.1,
            "tau0": 0.001,
            "is_complex": false,
            "dual": false,
            "attn_backend": "flex",
            "flex_block_size": 128
        }
    },
    "paths": {
        "save_dir": "trained_nets/bsd432/MGGroupLPDS_Denoiser",
        "ckpt": null
    },
    "data": {
        "train": {
            "name": "BSD432",
            "color": false,
            "batch_size": 8,
            "crop_size": 128,
            "center_crop": null,
            "random_flips": true,
            "root": "../datasets/CBSD432"
        },
        "val": {
            "name": "BSD432",
            "color": false,
            "batch_size": 1,
            "crop_size": null,
            "center_crop": null,
            "random_flips": false,
            "root": "../datasets/CBSD68"
        }
    },
    "training": {
        "num_epochs": 6000,
        "steps_per_epoch": 100,
        "val_every_epochs": 50,
        "noise_std": [
            0.098,
            0.098
        ],
        "noise_dist": "uniform",
        "loss_type": "magnitude-mse",
        "clip_grad": 0.05,
        "backtrack_thresh": 2.0,
        "backtrack_factor": 0.9
    },
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 0.0005
        }
    },
    "scheduler": {
        "type": "CosineAnnealingLR",
        "params": {
            "eta_min": 2e-06,
            "T_max": 600000
        }
    },
    "wandb": {
        "project": "denoiser_training",
        "id": null
    }
}