{
    "task": "recon",
    "experiment": {
        "name": "E2EVarNet_mg_brain_R4_synth"
    },
    "model": {
        "type": "E2EVarNet",
        "params": {
            "num_cascades": 12,
            "sens_chans": 8,
            "sens_pools": 4,
            "chans": 18,
            "pools": 4,
            "mask_center": true,
            "acs_lines": 20
        },
        "_comment": "fastMRI E2E-VarNet baseline at published defaults. Estimates its own sensitivity maps and returns RSS magnitude, so it is comparable on PSNR/SSIM/NRMSE and on nothing phase-sensitive."
    },
    "paths": {
        "save_dir": "trained_nets/mg_recon/brain/varnet_R4",
        "ckpt": null
    },
    "data": {
        "train": {
            "name": "fastmri",
            "task": "recon",
            "anatomy": "brain",
            "batch_size": 1,
            "crop_size": null,
            "center_crop": null,
            "random_flips": false,
            "start_slice": 0,
            "end_slice": 8,
            "scale_fac": 2000.0,
            "kspace_root": "../datasets/fastmri/brain/multicoil_train",
            "smap_root": "../datasets/fastmri_preprocessed/brain_T2W_coil_combined/train",
            "pad_multiple": 1
        },
        "val": {
            "name": "fastmri",
            "task": "recon",
            "anatomy": "brain",
            "batch_size": 1,
            "crop_size": null,
            "center_crop": null,
            "random_flips": false,
            "start_slice": 0,
            "end_slice": 1,
            "scale_fac": 2000.0,
            "kspace_root": "../datasets/fastmri/brain/multicoil_val",
            "smap_root": "../datasets/fastmri_preprocessed/brain_T2W_coil_combined/val",
            "pad_multiple": 1
        }
    },
    "training": {
        "num_epochs": 6000,
        "steps_per_epoch": 50,
        "val_every_epochs": 100,
        "noise_std": [
            0.04,
            0.06
        ],
        "noise_dist": "uniform",
        "val_noise_std": 0.05,
        "val_seed": 1234,
        "loss_type": "magnitude-nl1-nl2",
        "clip_grad": 1.0,
        "use_organ_mask": false,
        "backtrack_thresh": null,
        "backtrack_factor": 0.9
    },
    "mri": {
        "R": 4,
        "acs_lines": 20,
        "mask_dist": "uniform",
        "mask_offset": 0,
        "kspace_type": "simulated",
        "whiten_kspace": false
    },
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 0.0005
        }
    },
    "scheduler": {
        "type": "CosineAnnealingLR",
        "params": {
            "eta_min": 0.000001,
            "T_max": 300000
        }
    },
    "wandb": {
        "project": "mg_recon",
        "id": null
    }
}