% Fig. 1 -- MGLPDSNet architecture, in the layout of the LGGS paper's Fig. 2
% (Janjusevic et al., arXiv 2610.22643): the unrolled chain top left, the
% repeated block expanded top right, its sub-blocks in coloured panels below,
% operators as colour-coded chips, the legend in a column on the right.
% \input from a document that loads tikz (arrows.meta, calc), amsmath and bm;
% see fig1_arch_standalone.tex.
%
% Notation follows LPDSNet / LGGS (A^H, B, E^H E, eta, theta, lambda). Every
% path is what models/lpds.py and models/mg_lpds.py compute for the exp15/16
% cells: fas_dual=fixed_point (pi_z added after the clip), fas_copies=untied
% (the FAS block's own A^H, B, lambda), fas_parent_pi=true (the fine residual
% taken net of the level's own pi), coarse_op=rediscretize,
% transfer_filter=sinc_vertex, K=[6,[4,4,6]]. The FAS panel's steps 1-4 are
% the order of PDObjectiveDownsample.forward.
\definecolor{panelg}{HTML}{F1F2F6}  \definecolor{panelgD}{HTML}{3F4450}
\definecolor{gramc}{HTML}{D7DAE0}   \definecolor{gramD}{HTML}{6B7280}
\definecolor{sync}{HTML}{F1B58A}    \definecolor{synD}{HTML}{BF6A33}
\definecolor{anac}{HTML}{ABC8EA}    \definecolor{anaD}{HTML}{4673B0}
\definecolor{proxc}{HTML}{E9A6C9}   \definecolor{proxD}{HTML}{AE4A82}
\definecolor{grid}{HTML}{A8DCBA}    \definecolor{gridD}{HTML}{3A9861}
\definecolor{fasP}{HTML}{EFE0A2}    \definecolor{fasD}{HTML}{B19A3A}
\definecolor{ccP}{HTML}{CCC5EE}     \definecolor{ccD}{HTML}{6A5CB4}
\definecolor{lpdsc}{HTML}{BFE8F2}   \definecolor{lpdsD}{HTML}{23849E}
\definecolor{lpdsP}{HTML}{E6F5F9}
\begin{tikzpicture}[
    >={Stealth[length=1.9mm]}, font=\sffamily\footnotesize, line width=0.55pt,
    panel/.style={draw=#1, rounded corners=6pt, line width=0.8pt},
    ptitle/.style={font=\sffamily\small, anchor=north east, inner sep=3pt},
    chip/.style={draw=#1, rounded corners=1.5pt, line width=0.7pt,
                 minimum height=0.5cm, minimum width=0.65cm, inner sep=2pt},
    gram/.style={chip=gramD, fill=gramc},
    syn/.style={chip=synD, fill=sync},
    ana/.style={chip=anaD, fill=anac},
    prox/.style={chip=proxD, fill=proxc},
    trf/.style={chip=gridD, fill=grid},
    res/.style={chip=black!60, fill=white},
    tall/.style={draw=panelgD, fill=panelg, rounded corners=4pt,
                 minimum width=0.75cm, minimum height=3.4cm, line width=0.7pt},
    lyr/.style={draw=lpdsD, fill=lpdsc, rounded corners=2pt, line width=0.65pt,
                minimum width=0.3cm, minimum height=1.0cm, inner sep=0pt},
    lyrtxt/.style={rotate=90, font=\sffamily\tiny},
    fasb/.style={draw=fasD, fill=fasP, rounded corners=2pt, line width=0.7pt,
                 minimum width=0.62cm, minimum height=0.48cm, inner sep=1pt},
    ccb/.style={fasb, draw=ccD, fill=ccP},
    sum/.style={draw, circle, fill=white, inner sep=0pt, minimum size=3.1mm,
                path picture={\draw (path picture bounding box.north) -- (path picture bounding box.south)
                                    (path picture bounding box.west) -- (path picture bounding box.east);}},
    dot/.style={circle, fill, inner sep=0pt, minimum size=2.2pt},
    key/.style={font=\sffamily\scriptsize, inner sep=1pt, anchor=west},
    sgn/.style={font=\scriptsize, inner sep=0.5pt},
    fasline/.style={densely dashed, draw=gray},
    stepn/.style={circle, fill=fasD, text=white, inner sep=0.6pt,
                  minimum size=3.4mm, font=\sffamily\tiny\bfseries},
]

% ======================================================= unrolled V-cycles
\node[anchor=west] (yt) at (-0.15, -0.25) {$\tilde{\mathbf y}$};
\draw (yt.east) -- (5.25, -0.25);
\foreach \c/\t in {1.35/V-cycle, 2.45/, 4.15/, 5.25/} {
    \node[tall] at (\c, -2.55) {};
    \ifx\t\empty\else \node[rotate=90, font=\sffamily\small] at (\c, -2.55) {\t}; \fi
    \fill (\c, -0.25) circle (1.1pt);
    \draw[->] (\c, -0.25) -- (\c, -0.85);
}
\node[font=\Large] at (3.3, -1.75) {$\cdot\!\cdot\!\cdot$};
\node[font=\Large] at (3.3, -3.35) {$\cdot\!\cdot\!\cdot$};
\draw[->] (0.15, -0.25) |- (0.97, -1.75);
\draw[->] (0.25, -3.35) node[anchor=east] {$\mathbf z^{(0)}$} -- (0.97, -3.35);
\foreach \a/\b in {1.35/2.45, 4.15/5.25} {
    \draw[->] (\a+0.375, -1.75) -- (\b-0.375, -1.75);
    \draw[->] (\a+0.375, -3.35) -- (\b-0.375, -3.35);
}
\draw[->] (2.825, -1.75) -- (2.95, -1.75);  \draw[->] (3.65, -1.75) -- (3.775, -1.75);
\draw[->] (2.825, -3.35) -- (2.95, -3.35);  \draw[->] (3.65, -3.35) -- (3.775, -3.35);
\draw[->] (5.625, -1.75) -- (6.15, -1.75) node[right] {$\hat{\mathbf x}$};

% ======================================================= one V-cycle
\draw[panel=panelgD, fill=panelg] (6.95, 0.05) rectangle (17.05, -4.85);
\node[ptitle] at (17.05, 0.05) {V-cycle};
\def\Lz{-1.1} \def\Lo{-2.5} \def\Lt{-3.9}
\def\Mzo{-1.9} \def\Mot{-3.3}
\foreach \yy/\t in {\Lz/{$N$}, \Lo/{$N/2$}, \Lt/{$N/4$}} {
    \draw[black!18, densely dotted] (7.45, \yy) -- (16.9, \yy);
    \node[sgn, anchor=west] at (7.0, \yy) {\t};
}
% a run of LPDS Layers, vertical blocks side by side:
% \lpdsrun{name}{first x}{count}{y} -> nodes name1 .. name<count>
\newcommand{\lpdsrun}[4]{%
  \foreach \i in {1,...,#3} {
    \node[lyr] (#1\i) at ({#2 + (\i-1)*0.4}, #4) {};
    \node[lyrtxt] at (#1\i) {LPDS};
    \ifnum\i>1 \draw[->, line width=0.5pt] ({#2 + (\i-2)*0.4 + 0.15}, #4) -- ({#2 + (\i-1)*0.4 - 0.15}, #4); \fi
  }}
\lpdsrun{La}{7.9}{2}{\Lz}
\node[fasb] (f1) at (8.95, \Mzo) {FAS};
\lpdsrun{Lb}{9.55}{2}{\Lo}
\node[fasb] (f2) at (10.6, \Mot) {FAS};
\lpdsrun{Lc}{11.2}{6}{\Lt}
\node[ccb] (cc2) at (13.85, \Mot) {CC};
\lpdsrun{Ld}{14.45}{2}{\Lo}
\node[ccb] (cc1) at (15.5, \Mzo) {CC};
\lpdsrun{Le}{16.1}{2}{\Lz}
\draw[->] (7.5, \Lz) -- (La1.west);
\node[sgn, anchor=south] at (7.55, -0.55) {$(\mathbf x,\mathbf z)$};
\draw[->] (Le2.east) -- (17.2, \Lz);
\draw[->] (La2.east) -| (f1.north);
\draw[->] (f1.south) |- (Lb1.west);
\draw[->] (Lb2.east) -| (f2.north);
\draw[->] (f2.south) |- (Lc1.west);
\draw[->] (Lc6.east) -| (cc2.south);
\draw[->] (cc2.north) |- (Ld1.west);
\draw[->] (Ld2.east) -| (cc1.south);
\draw[->] (cc1.north) |- (Le1.west);
\draw[fasline, ->] (f1.east) -- (cc1.west);
\draw[fasline, ->] (f2.east) -- (cc2.west);
\node[sgn, anchor=north east] at (f1.south west) {$\boldsymbol\pi^{(1)}$};
\node[sgn, anchor=north east] at (f2.south west) {$\boldsymbol\pi^{(2)}$};

% ======================================================= LPDS Layer
\draw[panel=lpdsD, fill=lpdsP] (-0.15, -5.15) rectangle (7.3, -9.55);
\node[ptitle] at (7.3, -5.15) {LPDS Layer};
\def\X{-6.55} \def\Z{-8.35}
\node (xin) at (0.1, \X) {$\mathbf x$};
\node (zin) at (0.1, \Z) {$\mathbf z$};
\coordinate (xs) at (0.45, \X);
\node[gram, rotate=90] (ehe) at (1.15, \X) {$\mathbf E^H\mathbf E$};
\node[sum] (s1) at (2.05, \X) {};
\node[res, minimum width=0.45cm] (eta) at (2.8, \X) {$\eta$};
\node[sum] (s2) at (3.55, \X) {};
\node[syn] (B) at (2.05, -7.45) {$\mathbf B$};
\node[res, minimum width=0.45cm] (th) at (4.25, -7.45) {$\theta$};
\node[ana] (AH) at (5.15, -7.45) {$\mathbf A^H$};
\node[sum] (s3) at (5.15, \Z) {};
\node[prox, rotate=90] (pr) at (5.85, \Z) {$\Pi_{\boldsymbol\lambda}$};
\node[sum] (s4) at (6.45, \Z) {};
\draw (xin) -- (xs);
\draw[->] (xs) -- (ehe);
\draw[->] (ehe) -- (s1);
\draw[->] (s1) -- (eta);
\draw[->] (eta) -- node[sgn, pos=0.75, below] {$-$} (s2);
\draw[->] (xs) |- (3.55, -5.85) -- (s2.north);
\node[anchor=south] (ytin) at (2.05, -5.65) {$\tilde{\mathbf y}$};
\draw[->] (ytin) -- node[sgn, pos=0.85, left] {$-$} (s1.north);
\draw[->] (s2.east) -- (7.15, \X);
\node[anchor=south east] at (7.15, \X) {$\mathbf x^{+}$};
\fill (4.25, \X) circle (1.1pt);
\draw[->] (4.25, \X) -- (th);
\draw[->] (th) -- (AH);
\draw[->] (AH) -- (s3);
\draw (zin) -- (s3.west);
\fill (2.05, \Z) circle (1.1pt);
\draw[->] (2.05, \Z) -- (B);
\draw[->] (B) -- (s1);
\draw[->] (s3) -- (pr);
\draw[->] (pr) -- (s4);
\draw[->] (s4.east) -- (7.15, \Z);
\node[anchor=south east] at (7.15, \Z) {$\mathbf z^{+}$};
\draw[fasline, ->] (1.35, -7.25) node[anchor=north east, font=\scriptsize, inner sep=0pt] {$\boldsymbol\pi_x$}
    -- node[sgn, pos=0.75, left] {$-$} (s1.south west);
\draw[fasline, ->] (6.45, -8.9) node[anchor=north, font=\scriptsize, inner sep=1pt] {$\boldsymbol\pi_z$} -- (s4.south);

% ======================================================= Coarse Correction
\draw[panel=ccD, fill=ccP!55] (7.5, -5.15) rectangle (11.6, -9.55);
\node[ptitle] at (11.6, -5.15) {Coarse Correction};
\def\U{-7.0}
\node (uc) at (7.95, \U) {$\hat{\mathbf u}_c$};
\node[sum] (c1s) at (8.55, \U) {};
\node[trf] (P) at (9.25, \U) {$\mathbf P$};
\node[chip=gridD, fill=grid, minimum width=0.5cm] (al) at (10.0, \U) {$\boldsymbol\alpha$};
\node[sum] (c2s) at (10.7, \U) {};
\draw[->] (uc) -- (c1s);
\draw[->] (c1s) -- (P);
\draw[->] (P) -- (al);
\draw[->] (al) -- (c2s);
\draw[->] (8.55, -7.75) node[below] {$\mathbf u_c$} -- node[sgn, pos=0.6, left] {$-$} (c1s);
\draw[->] (10.7, -7.75) node[below] {$\mathbf u$} -- (c2s);
\draw[->] (c2s.east) -- node[sgn, above] {$\mathbf u$} (11.5, \U);

% ======================================================= legend (right column)
\begin{scope}[shift={(12.1, -5.75)}]
    \def\dy{0.385}
    \node[lyr, minimum height=0.36cm, minimum width=0.85cm] at (0.45, \dy) {\tiny LPDS};
    \node[key] at (1.0, \dy) {LPDS Layer};
    \node[gram, minimum height=0.36cm, minimum width=0.85cm] (g) at (0.45, 0) {$\mathbf E^H\mathbf E$};
    \node[key] at (1.0, 0) {MRI Gram operator};
    \node[ana, minimum height=0.36cm, minimum width=0.85cm] at (0.45, -\dy) {$\mathbf A^H$};
    \node[key] at (1.0, -\dy) {analysis conv ($1\!\to\!M$ channels)};
    \node[syn, minimum height=0.36cm, minimum width=0.85cm] at (0.45, -2*\dy) {$\mathbf B$};
    \node[key] at (1.0, -2*\dy) {synthesis conv ($M\!\to\!1$ channel)};
    \node[prox, minimum height=0.36cm, minimum width=0.85cm] at (0.45, -3*\dy) {$\Pi_{\boldsymbol\lambda}$};
    \node[key] at (1.0, -3*\dy) {noise-adaptive clipping};
    \node[trf, minimum height=0.36cm, minimum width=0.85cm] at (0.45, -4*\dy) {$\mathbf R,\mathbf P$};
    \node[key] at (1.0, -4*\dy) {restriction / prolongation};
    \node[chip=gridD, fill=grid, minimum height=0.36cm, minimum width=0.85cm] at (0.45, -5*\dy) {$\boldsymbol\alpha$};
    \node[key] at (1.0, -5*\dy) {learned per-channel step};
    \node[res, minimum height=0.36cm, minimum width=0.85cm] at (0.45, -6*\dy) {$\mathbf r^{(l)}$};
    \node[key] at (1.0, -6*\dy) {primal-dual residual, level $l$};
    \node[fasb, minimum height=0.36cm, minimum width=0.85cm] at (0.45, -7*\dy) {FAS};
    \node[key] at (1.0, -7*\dy) {FAS-Correction};
    \node[ccb, minimum height=0.36cm, minimum width=0.85cm] at (0.45, -8*\dy) {CC};
    \node[key] at (1.0, -8*\dy) {Coarse Correction};
    \node[sum] at (0.45, -9*\dy) {};
    \node[key] at (1.0, -9*\dy) {addition};
\end{scope}

% ======================================================= FAS-Correction
\def\T{-9.8}
\draw[panel=fasD, fill=fasP!45] (-0.15, \T) rectangle (17.05, -15.15);
\node[ptitle] at (17.05, \T) {FAS-Correction (level $l\to l{+}1$)};
\def\PX{-10.8} \def\RX{-11.3} \def\XX{-12.35} \def\ZZ{-13.1} \def\RZ{-13.85} \def\PZ{-14.55}

% --- step 1: the fine primal-dual residual, with the block's own A^H, B, lambda
\node (fx) at (0.05, \XX) {$\mathbf x$};
\node (fz) at (0.05, \ZZ) {$\mathbf z$};
\node[dot] (xa) at (0.6, \XX) {};
\node[dot] (xb) at (0.95, \XX) {};
\node[dot] (za) at (0.6, \ZZ) {};
\node[gram, rotate=90, minimum height=0.55cm] (fehe) at (1.45, \RX) {$\mathbf E^H\mathbf E$};
\node[sum] (fs1) at (2.3, \RX) {};
\node[syn, minimum height=0.4cm] (fB) at (2.3, -11.87) {$\mathbf B$};
\node[sum] (fs2) at (3.2, \RX) {};
\node[ana] (fA) at (1.65, \RZ) {$\mathbf A^H$};
\node[sum] (fs3) at (2.55, \RZ) {};
\node[prox, rotate=90, minimum height=0.55cm] (fP) at (3.35, \RZ) {$\Pi_{\boldsymbol\lambda}$};
\node[sum] (fs4) at (4.2, \RZ) {};
\node[sum] (fs5) at (5.0, \RZ) {};
\draw (fx) -- (xa);
\draw (fz) -- (za);
\draw[->] (xa) |- (fehe);
\draw[->] (fehe) -- (fs1);
\node[anchor=south, inner sep=1pt] (fyt) at (2.3, -10.75) {$\tilde{\mathbf y}$};
\draw[->] (fyt) -- node[sgn, pos=0.8, left] {$-$} (fs1.north);
\node[dot] at (2.3, \ZZ) {};
\draw[->] (2.3, \ZZ) -- (fB);
\draw[->] (fB) -- (fs1);
\draw[->] (fs1) -- (fs2);
\draw[fasline, ->] (3.2, -10.75) node[anchor=south, font=\scriptsize, inner sep=1pt] {$\boldsymbol\pi_x^{(l)}$}
    -- node[sgn, pos=0.8, right] {$-$} (fs2.north);
\draw[->] (xb) |- (fA);
\draw[->] (fA) -- (fs3);
\node[dot] at (2.55, \ZZ) {};
\draw[->] (2.55, \ZZ) -- (fs3);
\draw[->] (fs3) -- (fP);
\draw[->] (fP) -- node[sgn, pos=0.8, below] {$-$} (fs4);
\node[dot] at (4.2, \ZZ) {};
\draw[->] (4.2, \ZZ) -- (fs4);
\draw[->] (fs4) -- (fs5);
\draw[fasline, ->] (5.0, -14.45) node[anchor=north, font=\scriptsize, inner sep=1pt] {$\boldsymbol\pi_z^{(l)}$}
    -- node[sgn, pos=0.8, right] {$-$} (fs5.south);

% --- step 2: restrict the residual and the state
\foreach \yy/\nm in {\RX/R1, \XX/R2, \ZZ/R3, \RZ/R4}
    \node[trf, minimum width=0.55cm] (\nm) at (6.45, \yy) {$\mathbf R$};
\draw[->] (fs2) -- (R1);
\draw[->] (xb) -- (R2);
\draw[->] (za) -- (R3);
\draw[->] (fs5) -- (R4);

% --- step 3: the coarse residual at the restricted state (no pi: it is formed here)
\node[res, minimum width=1.3cm] (rcx) at (8.2, \PX) {$\mathbf r_x^{(l+1)}$};
\node[res, minimum width=1.3cm] (rcz) at (8.2, \PZ) {$\mathbf r_z^{(l+1)}$};
\node[dot] (tapx) at (7.85, \XX) {};
\node[dot] (tapz) at (8.55, \ZZ) {};
\draw (R2) -- (tapx);
\draw (R3) -- (tapz);
\draw[->] (tapx) -- (7.85,0 |- rcx.south);
\draw[->] (tapz) -- (8.55,0 |- rcx.south);
\draw[->] (tapx) -- (7.85,0 |- rcz.north);
\draw[->] (tapz) -- (8.55,0 |- rcz.north);

% --- step 4: pi = coarse residual - restricted fine residual
\node[sum] (tx) at (9.95, \PX) {};
\node[sum] (tz) at (9.95, \PZ) {};
\draw[->] (rcx) -- (tx);
\draw[->] (rcz) -- (tz);
\draw[->] (R1) -| node[sgn, pos=0.93, right] {$-$} (tx.south);
\draw[->] (R4) -| node[sgn, pos=0.93, right] {$-$} (tz.north);
\draw[->] (tx) -- (10.8, \PX) node[right, font=\footnotesize] {$\boldsymbol\pi_x^{(l+1)}$};
\draw[->] (tz) -- (10.8, \PZ) node[right, font=\footnotesize] {$\boldsymbol\pi_z^{(l+1)}$};
\draw[->] (tapx) -- (10.8, \XX) node[right, font=\footnotesize] {$\mathbf x_c$};
\draw[->] (tapz) -- (10.8, \ZZ) node[right, font=\footnotesize] {$\mathbf z_c$};

% --- the same operations as equations
\draw[black!15] (12.05, -10.45) -- (12.05, -14.95);
\foreach \n/\yy/\eq in {
    1/-11.15/{$\mathbf r_x=\mathbf E^H\mathbf E\mathbf x-\tilde{\mathbf y}+\mathbf B\mathbf z-\boldsymbol\pi_x^{(l)}$\\[2pt]
              $\mathbf r_z=\mathbf z-\Pi_{\boldsymbol\lambda}(\mathbf z+\mathbf A^H\mathbf x)-\boldsymbol\pi_z^{(l)}$},
    2/-12.25/{$\mathbf x_c=\mathbf R\mathbf x,\quad \mathbf z_c=\mathbf R\mathbf z$},
    3/-13.15/{$\mathbf r^{(l+1)}=\mathbf r_{l+1}(\mathbf x_c,\mathbf z_c)$},
    4/-14.05/{$\boldsymbol\pi^{(l+1)}=\mathbf r^{(l+1)}-\mathbf R\,\mathbf r$}} {
    \node[anchor=west, align=left, font=\sffamily\scriptsize, inner sep=0pt] at (12.4, \yy) {\eq};
}
\end{tikzpicture}
