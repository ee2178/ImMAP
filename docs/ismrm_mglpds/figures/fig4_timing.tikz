% Network time for the three main methods: one stacked bar per method, forward + backward
% (the network's share of one training step). Hand-written pgfplots.
% Needs \usepackage{pgfplots} \pgfplotsset{compat=1.16}. Width: \timingwidth, default \linewidth
% (a LENGTH). Segment colours are neutral so they do not clash with the method colours elsewhere.
% Source: time_net_l40s_planar.txt (L40S, 640x320, 20 coils, R=12; varnetmaps, lpdsnet, mg81v6).
\providecommand{\timingwidth}{\linewidth}
%                   E2E-VarNet  LPDSNet  MGLPDS     (ms, median of 30)
\def\fwdVN{48.0}  \def\fwdLP{38.8}  \def\fwdMG{57.2}
\def\bwdVN{87.3}  \def\bwdLP{56.4}  \def\bwdMG{77.6}
\definecolor{tmfwd}{HTML}{3F5F7F}
\definecolor{tmbwd}{HTML}{A9BCCF}
\definecolor{mbink}{HTML}{0B0B0B}
\definecolor{mbmuted}{HTML}{52514E}
\definecolor{mbgrid}{HTML}{E1E0D9}
\begin{tikzpicture}
\begin{axis}[
  xbar stacked, scale only axis, width=0.62\timingwidth, height=0.15\timingwidth,
  bar width=0.032\timingwidth, xmin=0, xmax=165, enlarge y limits=0.3,
  ytick={0,1,2}, yticklabels={MGLPDS, LPDSNet, E2E-VarNet},
  yticklabel style={font=\footnotesize, text=mbink}, y axis line style={draw=none},
  ytick style={draw=none}, xticklabel style={font=\footnotesize, text=mbmuted},
  xlabel={time per slice, forward + backward (ms)}, xlabel style={font=\small},
  axis x line*=bottom, axis line style={mbmuted}, tick style={mbmuted}, major tick length=2pt,
  xmajorgrids, grid style={mbgrid, line width=0.3pt},
  legend style={draw=none, font=\footnotesize, at={(0.5,1.03)}, anchor=south,
                legend columns=-1, /tikz/every even column/.append style={column sep=8pt}},
  area legend,
]
\addplot[fill=tmfwd, draw=white, line width=0.6pt,
         nodes near coords, nodes near coords style={font=\scriptsize, text=white},
         point meta=explicit symbolic]
  coordinates {(\fwdMG,0)[\fwdMG] (\fwdLP,1)[\fwdLP] (\fwdVN,2)[\fwdVN]};
\addlegendentry{forward}
\addplot[fill=tmbwd, draw=white, line width=0.6pt,
         nodes near coords, nodes near coords style={font=\scriptsize, text=mbink},
         point meta=explicit symbolic]
  coordinates {(\bwdMG,0)[\bwdMG] (\bwdLP,1)[\bwdLP] (\bwdVN,2)[\bwdVN]};
\addlegendentry{backward}
% totals at the end of each bar
\pgfmathsetmacro{\totMG}{\fwdMG+\bwdMG}\pgfmathsetmacro{\totLP}{\fwdLP+\bwdLP}
\pgfmathsetmacro{\totVN}{\fwdVN+\bwdVN}
\node[font=\scriptsize\bfseries, text=mbink, anchor=west] at (axis cs:\totMG,0)
  {\pgfmathprintnumber[fixed, precision=1, fixed zerofill]{\totMG}};
\node[font=\scriptsize\bfseries, text=mbink, anchor=west] at (axis cs:\totLP,1)
  {\pgfmathprintnumber[fixed, precision=1, fixed zerofill]{\totLP}};
\node[font=\scriptsize\bfseries, text=mbink, anchor=west] at (axis cs:\totVN,2)
  {\pgfmathprintnumber[fixed, precision=1, fixed zerofill]{\totVN}};
\end{axis}
\end{tikzpicture}
