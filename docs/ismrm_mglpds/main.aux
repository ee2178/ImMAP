\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Residual aliasing in LPDSNet. Columns: zero-filled, E2E-VarNet, LPDSNet, MGLPDSNet and the ground truth, with PSNR per slice. Below each image: the boxed region and its absolute error. LPDSNet leaves thin line artifacts that are absent from the ground truth (brain, $R{=}8$: a bright streak; brain, $R{=}12$: a dark line; knee, $R{=}12$: an oblique streak), visible as bright lines in its error maps; MGLPDSNet and E2E-VarNet reconstruct the same regions without them.}}{4}{}\protected@file@percent }
\newlabel{fig:alias}{{3}{4}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Quantitative comparison. Top: PSNR, SSIM and NRMSE within the anatomy mask, mean $\pm $ s.e.m.\ over test volumes (brain $n{=}815$, knee $n{=}100$); bold: best per experiment; $^{*}$: differs from MGLPDSNet (paired Wilcoxon signed-rank over volumes, Holm-adjusted, $p<0.05$). Bottom: network time per $640\times 320$, 20-coil slice on one NVIDIA L40S (median of 30 runs), forward and backward pass. Parameters: E2E-VarNet 29.5M, LPDSNet 1.0M, MGLPDSNet ($M{=}81$) 1.7M.}}{5}{}\protected@file@percent }
\newlabel{fig:bars}{{4}{5}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Ablations, knee R=8: time against quality. Top: test PSNR against inference time ($640\times 320$, 20 coils, NVIDIA L40S) across the width sweep (subbands $M$ at 6 V-cycles, left) and the depth sweep (V-cycles at $M{=}81$, right), with LPDSNet and E2E-VarNet for reference. Bottom: the same networks in full, mean $\pm $ s.e.m.\ over $n{=}100$ test volumes; bold: best in its sweep; $^{*}$: differs from $M{=}81$, 6 V-cycles (paired Wilcoxon signed-rank over volumes, Holm-adjusted, $p<0.05$). \textcolor {red}{[4 V-cycles: still training]}}}{6}{}\protected@file@percent }
\newlabel{fig:ablation}{{5}{6}{}{figure.5}{}}
